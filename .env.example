# Required for `make eval` and `ledger extract`. Not needed for tests or fixtures.
ANTHROPIC_API_KEY=

# Model used for extraction. Default is Opus 5.5 (quality ceiling). Re-run eval with
# claude-haiku-5-5 and claude-sonnet-5-5 to find the cheapest model that holds targets.
LEDGER_MODEL=claude-opus-5-5

# Where the SQLite ledger lives.
LEDGER_DB=./ledger.db

# Your identity, so the extractor knows which "I" is you. Slack user id and display names.
LEDGER_ME_SLACK_ID=
LEDGER_ME_NAMES=Edy,Edy Richardson
