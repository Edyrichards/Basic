{
  "name": "commitment-ledger",
  "version": "0.1.0",
  "description": "Prototype: cross-source commitment ledger (Slack export + calendar + meeting notes -> obligations, nightly reconcile, morning brief, MCP server)",
  "type": "module",
  "private": true,
  "engines": { "node": ">=22.13" },
  "bin": { "ledger": "./dist/cli.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "ledger": "node --no-warnings --import tsx src/cli.ts",
    "mcp": "node --no-warnings --import tsx src/mcp/server.ts",
    "eval": "node --no-warnings --import tsx src/eval/run.ts",
    "fixtures": "node --no-warnings --import tsx src/eval/generate_fixtures.ts"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.3.0",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "chrono-node": "^2.8.0",
    "commander": "^14.0.0",
    "zod": "^4.6.6"
  },
  "devDependencies": {
    "@types/node": "^22.15.0",
    "tsx": "^4.20.0",
    "typescript": "^5.8.0",
    "vitest": "^3.2.0"
  }
}
